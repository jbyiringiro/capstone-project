# copy to .env for local runs of the API outside Docker
VUGA_DATABASE_URL=sqlite:///./vuga_dev.db
VUGA_JWT_SECRET=replace-with-a-long-random-string
VUGA_MODEL_DIR=../ml/artifacts
VUGA_DEFAULT_MODEL=kn_trigram.json
# Exact frontend origins, with no trailing slash. Render uses its public app URL in render.yaml.
VUGA_CORS_ORIGINS=["http://localhost:5173"]
# Email accounts: enable Firebase Authentication Email/Password on the no-cost Spark plan.
# Use the same project's web config values in app/.env.local (see app/.env.example).
# No service-account JSON/private key is needed. Blank values disable email sign-in safely.
VUGA_FIREBASE_PROJECT_ID=vuga-sms-test
VUGA_FIREBASE_API_KEY=
# SMS codes for opening an account and replacing a forgotten PIN (docs/hosting.md, "Live SMS").
# - USERNAME: "sandbox" sends to Africa's Talking's sandbox simulator only, never to a phone. For
#   real phones use the live app's username, with that app's live API key.
# - API_KEY: secret. Never commit it; on Render set it in the dashboard. Empty means no provider.
# - SENDER_ID: optional; an alphanumeric sender ID or short code approved for your account (in
#   Rwanda, registered with MTN and Airtel). Leave unset to use the account's default sender.
# The API logs which mode it started in, and GET /health reports it as "sms": sms, simulator,
# log or off, without the key.
VUGA_AFRICASTALKING_USERNAME=sandbox
VUGA_AFRICASTALKING_API_KEY=
# VUGA_AFRICASTALKING_SENDER_ID=VUGA
# Local development only: with no API key, write each code to the API's log. Keep it false on any
# public host (render.yaml does), so missing credentials refuse codes (503) instead of logging them.
VUGA_SMS_LOG_ENABLED=true
