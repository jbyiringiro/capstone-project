# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
*.egg-info/
dist/
build/

# Data and artefacts (never commit corpora, logs or model binaries)
ml/data/raw/*
!ml/data/raw/README.md
ml/data/processed/*
!ml/data/processed/README.md
ml/artifacts/*
!ml/artifacts/README.md
# small statistical models and validation results are committed; weights (.pt/.onnx) are not
!ml/artifacts/*.json
vocab/audio/*
!vocab/audio/README.md
# adult-study files (trial logs, transcribed review sheets): study codes only, still never committed
/study/
*.pt
*.onnx
*.bin

# Node
node_modules/
app/dist/
app/dev-dist/

# Environment and IDE
.env
.env.*
!.env.example
.idea/
.vscode/
*.log
.DS_Store
Thumbs.db

# derived app assets
app/public/models/*
!app/public/models/README.md
!app/public/models/kn_trigram.json
app/public/audio/*
!app/public/audio/README.md
!app/public/audio/rw/
!app/public/audio/speaker-test.wav
!app/public/audio/installed.json
# app/tests/prediction/fixtures/*.json are committed: small snapshots used by the JS parity tests
device/bundle/*.json

# ARASAAC pictograms are fetched by ml/scripts/fetch_pictograms.py (CC BY-NC-SA), not committed
app/public/symbols/*.png

# Linters
.ruff_cache/

# Local development databases (the API creates vuga_dev.db; never commit participant data)
*.db
*.sqlite3
