# Copy to app/.env.local before running/building the frontend.
# Every VITE_ value is public in the browser bundle. Never put database/admin/SMS secrets here.
VITE_API_BASE=http://localhost:8000
# Firebase Project settings -> General -> Your apps -> web app configuration.
# Enable Authentication -> Sign-in method -> Email/Password. No Blaze plan is needed.
# The backend must use this same project's values as VUGA_FIREBASE_PROJECT_ID/API_KEY.
VITE_FIREBASE_PROJECT_ID=vuga-sms-test
VITE_FIREBASE_API_KEY=
